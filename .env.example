# ─────────────────────────────────────────────────────────────
# App / Auth
# ─────────────────────────────────────────────────────────────
# Public URL where the browser reaches the app (host port 2001 under compose).
# Baked into the client bundle at build time — must be reachable from the browser.
VITE_BASE_URL=http://localhost:3000
# Secret used by better-auth to sign sessions. Generate a random value:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# ─────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────
# Connection string the app uses. For docker compose use host `db` and match the
# POSTGRES_* values in the "Docker-bundled infra" section below. For local dev use
# your own Postgres (host `localhost`).
DATABASE_URL=postgres://app:app@db:5432/app

# ─────────────────────────────────────────────────────────────
# Email (SMTP — Gmail app credentials for nodemailer)
# ─────────────────────────────────────────────────────────────
SMTP_USER=
SMTP_PASS=

# ─────────────────────────────────────────────────────────────
# Object storage (S3 / MinIO) — optional
# ─────────────────────────────────────────────────────────────
# Only needed for file uploads (task attachments). Read lazily by
# src/lib/storage.ts, so an app that never uploads can leave these unset.
# Endpoint is the `minio` compose service (container port 9000). Path-style is
# required for MinIO. With the bundled MinIO, these credentials also become its
# root user/password (compose derives them), so set them here as the single source.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=app
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ─────────────────────────────────────────────────────────────
# Initial admin (optional)
# ─────────────────────────────────────────────────────────────
# Bootstraps the first admin on a fresh database — a new deployment has no admin,
# and every route is permission-gated, so there's no in-app way to create one.
# Read once at startup (after migrations) and by `pnpm db:seed`.
#
# Leave blank to skip seeding entirely. Safe to leave set: the seed never modifies
# an email that already exists, so it won't overwrite a password or re-grant admin.
# Password must be at least 8 characters (matches the app's minPasswordLength).
# The seeded account is created pre-verified, so it can sign in without email setup.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin

# ─────────────────────────────────────────────────────────────
# Docker-bundled infra (compose only)
# ─────────────────────────────────────────────────────────────
# Credentials for the bundled `db` Postgres container. The app itself connects via
# DATABASE_URL above — keep these in sync with it. Not needed for local dev.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
